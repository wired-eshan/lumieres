# Vite fingerprints every file in /assets, so those URLs never change contents.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Headers applied to every static response, including the SPA fallback.
# Only this block sets Cache-Control so the two rules cannot merge conflicting values.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
